{
  "name": "meditor",
  "version": "1.3.2",
  "private": true,
  "description": "Chrome extension that detects news articles and clips them to a Glide webhook.",
  "type": "module",
  "scripts": {
    "test": "node tests/run.mjs",
    "screenshots": "node tests/run.mjs --shots",
    "icons": "node scripts/build_icons.mjs",
    "package": "bash scripts/package.sh",
    "relay": "node relay/dev-server.mjs",
    "store-assets": "node scripts/store_assets.mjs"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
